{
  "name": "kpanah-lang-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive AI language tutor - Telegram Mini App + Serverless Edge backend",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev:tma": "npm run dev -w @kpanah/tma",
    "dev:edge": "npm run dev -w @kpanah/edge",
    "build": "npm run build -w @kpanah/shared && npm run build -w @kpanah/edge && npm run build -w @kpanah/tma",
    "build:shared": "npm run build -w @kpanah/shared",
    "build:tma": "npm run build -w @kpanah/tma",
    "build:edge": "npm run build -w @kpanah/edge",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
