# ═══════════════════════════════════════════════════════════════════════
#  نمونه پیکربندی — این فایل هرگز نباید مقدار واقعی داشته باشد.
#
#  کلیدهای واقعی را در فایل `.env` بگذارید (که در .gitignore است).
#  برای ثبت روی Cloudflare:  bash scripts/set-secrets.sh
# ═══════════════════════════════════════════════════════════════════════

# --- Telegram ---
# از @BotFather گرفته می‌شود (فاز ۲.۱ راهنما)
TELEGRAM_BOT_TOKEN=
# با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# ربات ادمین جداگانه (فاز ۲.۲)
TELEGRAM_ADMIN_BOT_TOKEN=
# شناسه عددی خودتان از @userinfobot (فاز ۲.۳) — چند نفر با کاما
TELEGRAM_ADMIN_IDS=

# --- Supabase (فاز ۱.۲ → Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# ⚠️ این کلید تمام RLS را دور می‌زند — فقط در secret ورکر
SUPABASE_SERVICE_ROLE_KEY=

# --- JWT ---
# با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Upstash QStash (فاز ۴) ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Multi-AI Engine ---
# این کلیدها فقط برای provider های seed شده استفاده می‌شوند.
# برای افزودن موتور جدید، از پنل ادمین استفاده کنید — آن کلیدها
# رمزنگاری‌شده در دیتابیس ذخیره می‌شوند، نه اینجا.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_PRIMARY_MODEL=gemini-2.5-flash
AI_FALLBACK_MODELS=deepseek-chat,claude-3-5-sonnet-latest

# کلید master برای رمزنگاری کلیدهای provider در دیتابیس.
# با دستور زیر بسازید:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ اگر این را عوض کنید، کلیدهای ذخیره‌شده در پنل ادمین غیرقابل خواندن می‌شوند.
PROVIDER_ENCRYPTION_KEY=

# --- Security ---
# مسیر مبهم‌سازی‌شده دروازه API
GATE_PATH=/kpanah56/8fjg7rfb/v1/gate

# --- TMA (Mini App) client build config ---
# ⚠️ MUST be set in the TMA build, otherwise the client makes *relative*
# calls to the Pages origin, gets a 404 HTML, and the user sees
# "Temporary server issue. Try again shortly." forever.
# If left empty, apps/tma/src/lib/api.ts falls back to this same URL,
# but set it explicitly so the value is baked into the build.
VITE_API_BASE=https://kpanah-lang-edge.language-app-backend.workers.dev
VITE_GATE_PATH=/kpanah56/8fjg7rfb/v1/gate

# لایه رمزنگاری payload (اختیاری - پیش‌فرض خاموش)
ENABLE_PAYLOAD_ENCRYPTION=false
PAYLOAD_ENCRYPTION_KEY=
# محدودیت نرخ درخواست
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=2000

# --- Business rules ---
FREE_TRIAL_DAYS=7
CYCLE_STALL_DAYS=12
